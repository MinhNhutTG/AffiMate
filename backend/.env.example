PORT=4000

MONGODB_URI=mongodb://localhost:27017/affimate
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PHOTOROOM_API_KEY=
# photoroom-basic (mặc định, gói free hiện dùng) | photoroom-plus (chưa triển khai,
# xem chuc-nang-tao-anh-ai.md mục 11 câu 10)
IMAGE_AI_PROVIDER=photoroom-basic

# Option "Mô tả nền theo ý bạn" (backgroundPrompt, hiện đang đánh dấu "Đang
# phát triển" trên UI — chưa mở cho user thật dùng chính thức, xem
# chuc-nang-tao-anh-ai.md mục 11) — chọn provider qua BACKGROUND_PROMPT_PROVIDER:
# "photoroom-sandbox" (mặc định, đã test ổn định 100%, có watermark) |
# "cloudflare" (không watermark nhưng hay báo "Capacity exceeded", xem
# CLOUDFLARE_* bên dưới).
BACKGROUND_PROMPT_PROVIDER=photoroom-sandbox

# --- PhotoRoom Sandbox (mặc định cho backgroundPrompt) ---
# true (mặc định) = sandbox (MIỄN PHÍ nhưng ảnh LUÔN có watermark, giới hạn
# 1.000 lượt/tháng — 100 lượt/ngày CHUNG cho toàn app). Đổi false khi đã có key
# production thật của gói Plus (trả phí, không watermark).
PHOTOROOM_BACKGROUND_SANDBOX=true

# --- Cloudflare Workers AI (phương án phụ cho backgroundPrompt) ---
# 1. Đăng ký tài khoản Cloudflare miễn phí (KHÔNG cần thẻ tín dụng) tại
#    dash.cloudflare.com.
# 2. Lấy Account ID: dashboard → Workers AI → copy "Account ID".
# 3. Tạo API Token: My Profile → API Tokens → Create Token → quyền
#    "Workers AI - Edit".
# Free tier: 10.000 neurons/ngày, KHÔNG watermark — nhưng model ảnh hay báo lỗi
# "Capacity temporarily exceeded" (đã test nhiều lần), độ ổn định thấp hơn
# PhotoRoom Sandbox nên chưa đặt làm mặc định.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BG_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
CLOUDFLARE_TIMEOUT_MS=30000
# 0 = gần như giữ nguyên ảnh gốc, 1 = gần như bỏ qua ảnh gốc. Model img2img
# thuần (không mask) nên biến đổi toàn ảnh — chỉnh giá trị này nếu sản phẩm bị
# đổi dáng quá nhiều hoặc nền đổi chưa đủ rõ.
CLOUDFLARE_IMG2IMG_STRENGTH=0.6

DAILY_IMAGE_GEN_LIMIT=10
FETCH_SOURCE_TIMEOUT_MS=10000
PHOTOROOM_TIMEOUT_MS=20000
