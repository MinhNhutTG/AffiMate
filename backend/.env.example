PORT=4000

MONGODB_URI=mongodb://localhost:27017/affimate
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PHOTOROOM_API_KEY=
# photoroom-basic (mặc định, gói free hiện dùng) | photoroom-plus (chưa triển khai,
# xem chuc-nang-tao-anh-ai.md mục 11 câu 10)
IMAGE_AI_PROVIDER=photoroom-basic

# Option "Mô tả nền theo ý bạn" (backgroundPrompt) — dùng Hugging Face Inference
# Providers để sinh nền theo mô tả, KHÔNG cần gói PhotoRoom Plus.
# 1. Đăng ký tài khoản miễn phí tại huggingface.co (có gói free dạng credit hàng
#    tháng, không phải unlimited — xem chuc-nang-tao-anh-ai.md mục 6).
# 2. Vào Settings → Access Tokens → tạo token (permission "Make calls to
#    Inference Providers").
# 3. Model mặc định bên dưới là "gated" — cần vào trang model trên huggingface.co,
#    bấm "Agree" 1 lần trước khi token gọi được (chỉ là bước xác nhận, không mất
#    thời gian duyệt).
HUGGINGFACE_API_KEY=
HUGGINGFACE_BG_MODEL=black-forest-labs/FLUX.1-schnell
HUGGINGFACE_TIMEOUT_MS=30000

DAILY_IMAGE_GEN_LIMIT=10
FETCH_SOURCE_TIMEOUT_MS=10000
PHOTOROOM_TIMEOUT_MS=20000
