PORT=4000

MONGODB_URI=mongodb://localhost:27017/affimate
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PHOTOROOM_API_KEY=
# photoroom-basic (mặc định, gói free hiện dùng) | photoroom-plus (chưa triển khai,
# xem chuc-nang-tao-anh-ai.md mục 11 câu 10)
IMAGE_AI_PROVIDER=photoroom-basic

# Option "Mô tả nền theo ý bạn" (backgroundPrompt) — dùng PhotoRoom Sandbox mode
# (endpoint /v2/edit, background.prompt), KHÔNG cần gói Plus, dùng chung
# PHOTOROOM_API_KEY ở trên. true (mặc định) = sandbox (MIỄN PHÍ nhưng ảnh LUÔN có
# watermark, giới hạn 1.000 lượt/tháng — 100 lượt/ngày CHUNG cho toàn app). Đổi
# false khi đã có key production thật của gói Plus (trả phí, không watermark) —
# xem chuc-nang-tao-anh-ai.md mục 6.
PHOTOROOM_BACKGROUND_SANDBOX=true

DAILY_IMAGE_GEN_LIMIT=10
FETCH_SOURCE_TIMEOUT_MS=10000
PHOTOROOM_TIMEOUT_MS=20000
